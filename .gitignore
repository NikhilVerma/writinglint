# Secrets — never commit (Cloudflare API token lives in .env)
.env
.env.*
!.env.example

node_modules/
dist/
dist-cli/
packages/*/dist/
packages/vscode-extension/*.vsix
packages/vscode-extension/bin/
packages/vscode-extension/.vscode-test/
packages/slopsift-chrome/*.zip
packages/slopsift-chrome/*.crx

# Astro (packages/web) build + generated types
packages/web/.astro/
packages/web/dist/

# Web build outputs + staged runtime assets (generated by build:client / copy-runtime)
packages/web/public/model/
packages/web/public/ort/
packages/web/public/*.js
packages/web/public/*.css
packages/web/public/*.map
packages/web/public/*.ttf

.DS_Store
*.log
scratch-*.ts
scratch-*.mjs
scratchpad/

# Local corpus audits can contain absolute paths or unpublished writing.
*blog-findings*.jsonl
*.slopsift.jsonl

# Local editor settings. Keep shared extension recommendations intentional.
.idea/
.vscode/*
!.vscode/extensions.json

# Cloudflare Wrangler local state (Pages/R2 dev + build cache)
.wrangler/

# The vendored ONNX parser model (~145MB) is downloaded, never committed.
# The trained classifier (packages/rulepack-ai-style/model/classifier.json) IS
# committed — it's data-free (vocab + weights only).
models/*/
packages/parser-node/model/
packages/vscode-extension/model/

# Eval data is CLOSED-SOURCE (third-party text; kept private). Never commit it here.
eval/data/
# Local A/B calibration can also contain full third-party and generated rewrites.
a-b-test/

# Example apps: installed deps + downloaded model (not committed)
examples/**/node_modules/
examples/**/models/
examples/**/package-lock.json

# simplification dataset pipeline: generated corpora and run state stay local
training/simplify/sources/
training/simplify/runs/
training/simplify/.durably/
# human-vs-AI paired corpus: private, never published or committed
training/simplify/corpus/
