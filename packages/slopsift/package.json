{
  "name": "slopsift",
  "version": "0.4.0",
  "description": "Lint Markdown, prose, and source-code comments for AI writing slop.",
  "type": "module",
  "license": "MIT",
  "author": "Nikhil Verma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikhilVerma/writinglint.git",
    "directory": "packages/slopsift"
  },
  "bugs": {
    "url": "https://github.com/NikhilVerma/writinglint/issues"
  },
  "homepage": "https://slopsift.dev",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extract": {
      "source": "./src/extract.ts",
      "types": "./dist/extract.d.ts",
      "default": "./dist/extract.js"
    },
    "./rules": "./rules/index.json",
    "./schema/result-v1.json": "./schema/slopsift-result-v1.schema.json"
  },
  "bin": {
    "slopsift": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "rules",
    "schema",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "MODEL.md",
    "RELEASING.md",
    "CALIBRATION.md",
    "AUDIT.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-slop",
    "linter",
    "markdown",
    "comments",
    "cli",
    "prose",
    "ai-writing",
    "writinglint"
  ],
  "dependencies": {
    "ignore": "^7.0.5",
    "tinyglobby": "^0.2.17",
    "writinglint-core": "^0.1.1",
    "writinglint-parser-node": "^0.1.7",
    "writinglint-rulepack-ai-style": "^0.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepack": "npm run build"
  }
}
