{
  "name": "writinglint-rulepack-reader-first",
  "version": "0.3.0",
  "description": "Deterministic WritingLint rules that reduce cognitive load and unexplained jargon.",
  "type": "module",
  "license": "MIT",
  "author": "Nikhil Verma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikhilVerma/writinglint.git",
    "directory": "packages/rulepack-reader-first"
  },
  "bugs": {
    "url": "https://github.com/NikhilVerma/writinglint/issues"
  },
  "homepage": "https://slopsift.dev",
  "keywords": [
    "plain-language",
    "reader-first",
    "rulepack",
    "writinglint"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "writinglint-core": "^0.3.0"
  },
  "devDependencies": {
    "writinglint-parser-node": "^0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
