{
  "name": "writinglint-web",
  "version": "0.1.0",
  "description": "Docs + live browser demo for the WritingLint grammar linter (Astro + Starlight). One consumer of the library.",
  "type": "module",
  "license": "MIT",
  "author": "Nikhil Verma",
  "private": true,
  "scripts": {
    "dev": "node dev.mjs",
    "build:client": "node build-client.mjs",
    "copy-runtime": "node copy-runtime.mjs",
    "build": "npm run copy-runtime && npm run build:client && astro build",
    "build:site": "npm run build:client && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.2.2",
    "onnxruntime-web": "^1.27.0",
    "sharp": "^0.35.3",
    "starlight-typedoc": "^0.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "writinglint-core": "*",
    "writinglint-parser-node": "*",
    "writinglint-rulepack-ai-style": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
