{
  "name": "sloplint-vscode",
  "displayName": "Sloplint",
  "version": "0.1.0",
  "description": "ESLint-like diagnostics for AI slop in prose and code comments.",
  "license": "MIT",
  "author": "Nikhil Verma",
  "publisher": "nikhilverma",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "ai slop",
    "linter",
    "markdown",
    "prose",
    "comments"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Sloplint's native local ONNX runtime requires a filesystem-backed extension host."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "sloplint.lintDocument",
        "title": "Lint Active Document",
        "category": "Sloplint"
      },
      {
        "command": "sloplint.showOutput",
        "title": "Show Output",
        "category": "Sloplint"
      }
    ],
    "configuration": {
      "title": "Sloplint",
      "properties": {
        "sloplint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable local Sloplint diagnostics."
        },
        "sloplint.minimumLevel": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "enumDescriptions": [
            "Show possible, suspected, and high-confidence slop.",
            "Show suspected and high-confidence slop.",
            "Show only high-confidence slop."
          ],
          "default": "warning",
          "description": "Minimum finding level shown in the Problems panel."
        },
        "sloplint.modelPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional absolute path to a Sloplint ONNX model bundle."
        },
        "sloplint.downloadModel": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "description": "Allow a one-time model download when no cached or configured model exists. Inference is always local."
        },
        "sloplint.debounceMilliseconds": {
          "type": "number",
          "default": 450,
          "minimum": 100,
          "maximum": 5000,
          "description": "Delay after edits before linting the document."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NikhilVerma/writinglint.git",
    "directory": "packages/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/NikhilVerma/writinglint/issues"
  },
  "homepage": "https://github.com/NikhilVerma/writinglint/tree/main/packages/vscode-extension#readme",
  "dependencies": {
    "onnxruntime-node": "^1.27.0",
    "sloplint": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run check-types && node esbuild.mjs --production",
    "vscode:prepublish": "npm run package",
    "vsix": "node package-vsix.mjs",
    "test": "node --conditions=source --import tsx --test test/*.test.ts"
  }
}
