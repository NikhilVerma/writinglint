{
  "name": "slopsift-vscode",
  "displayName": "SlopSift",
  "version": "0.1.0",
  "description": "ESLint-like diagnostics for AI slop in prose and code comments.",
  "private": true,
  "license": "MIT",
  "author": "Nikhil Verma",
  "publisher": "NikhilVerma01",
  "preview": true,
  "icon": "icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#f4f1e8",
    "theme": "light"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "ai slop",
    "linter",
    "markdown",
    "prose",
    "comments"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:astro",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:css",
    "onLanguage:dart",
    "onLanguage:go",
    "onLanguage:html",
    "onLanguage:java",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:kotlin",
    "onLanguage:less",
    "onLanguage:lua",
    "onLanguage:markdown",
    "onLanguage:mdx",
    "onLanguage:php",
    "onLanguage:plaintext",
    "onLanguage:python",
    "onLanguage:r",
    "onLanguage:ruby",
    "onLanguage:rust",
    "onLanguage:sass",
    "onLanguage:scala",
    "onLanguage:scss",
    "onLanguage:shellscript",
    "onLanguage:sql",
    "onLanguage:svelte",
    "onLanguage:swift",
    "onLanguage:toml",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:xml",
    "onLanguage:yaml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "SlopSift's native local ONNX runtime requires a filesystem-backed extension host."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "slopsift.lintDocument",
        "title": "Lint Active Document",
        "category": "SlopSift"
      },
      {
        "command": "slopsift.showOutput",
        "title": "Show Output",
        "category": "SlopSift"
      }
    ],
    "configuration": {
      "title": "SlopSift",
      "properties": {
        "slopsift.enable": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable local SlopSift diagnostics."
        },
        "slopsift.minimumLevel": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "enumDescriptions": [
            "Show possible, suspected, and high-confidence slop.",
            "Show suspected and high-confidence slop.",
            "Show only high-confidence slop."
          ],
          "default": "warning",
          "scope": "resource",
          "description": "Minimum finding level shown in the Problems panel."
        },
        "slopsift.modelPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional absolute path to a SlopSift ONNX model bundle."
        },
        "slopsift.downloadModel": {
          "type": "boolean",
          "default": false,
          "scope": "machine-overridable",
          "description": "Allow a model download only when the bundled or configured model cannot be used. Inference is always local."
        },
        "slopsift.debounceMilliseconds": {
          "type": "number",
          "default": 450,
          "minimum": 100,
          "maximum": 5000,
          "scope": "resource",
          "description": "Delay after edits before linting the document."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NikhilVerma/writinglint.git",
    "directory": "packages/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/NikhilVerma/writinglint/issues"
  },
  "homepage": "https://slopsift.dev/",
  "dependencies": {
    "onnxruntime-node": "^1.27.0",
    "slopsift": "^0.2.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "setup-model": "node ../../scripts/setup-model.mjs",
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run setup-model && npm run check-types && node esbuild.mjs --production",
    "vscode:prepublish": "npm run package",
    "vsix": "node package-vsix.mjs",
    "test": "node --conditions=source --import tsx --test test/*.test.ts",
    "test:integration": "node esbuild.mjs --test && vscode-test",
    "test:release": "npm run vsix && npm run test:integration"
  }
}
