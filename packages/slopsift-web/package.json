{
  "name": "slopsift-web",
  "version": "0.1.0",
  "description": "The SlopSift product site and local Markdown writing editor.",
  "type": "module",
  "private": true,
  "scripts": {
    "setup-model": "node ../../scripts/setup-model.mjs",
    "generate:agent": "node --conditions=source --import tsx ../../scripts/generate-slopsift-agent-surfaces.ts",
    "check:agent": "node --conditions=source --import tsx ../../scripts/generate-slopsift-agent-surfaces.ts --check",
    "dev": "npm run generate:agent && npm run setup-model && npm run copy-runtime && npm run build:client && astro dev",
    "check-types": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.worker.json",
    "build:client": "node build-client.mjs",
    "copy-runtime": "node copy-runtime.mjs",
    "clean-runtime": "node clean-runtime.mjs",
    "build": "npm run clean-runtime && npm run build:site",
    "build:local": "npm run generate:agent && npm run setup-model && npm run copy-runtime && npm run build:client && astro build",
    "build:site": "npm run generate:agent && npm run build:client && astro build",
    "preview": "astro preview",
    "r2:create": "wrangler r2 bucket create slopsift-models",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "astro": "^7.2.2",
    "codemirror": "^6.0.2",
    "onnxruntime-web": "^1.27.0",
    "slopsift": "^0.8.2",
    "writinglint-core": "*",
    "writinglint-parser-node": "*",
    "writinglint-rulepack-ai-style": "*",
    "writinglint-rulepack-reader-first": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.123.0"
  }
}
