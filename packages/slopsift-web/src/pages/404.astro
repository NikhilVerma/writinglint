---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found | SlopSift" description="This SlopSift page does not exist." noindex>
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="SlopSift home"><span>slop</span><span>sift</span><i aria-hidden="true"></i></a>
    <nav aria-label="Not found navigation"><a href="/docs/">Docs</a><a href="https://github.com/NikhilVerma/writinglint">GitHub</a><a class="nav-install" href="/#demo">Try SlopSift</a></nav>
  </header>
  <main class="not-found-page">
    <section>
      <p class="kicker">404 / no finding range</p>
      <h1>This page<br />isn’t in<br />the draft.</h1>
      <p>The URL does not point to a SlopSift page. The live editor, CLI docs, and source are still where we left them.</p>
      <div class="hero__actions">
        <a class="button button--primary" href="/">Back to SlopSift</a>
        <a class="button not-found-page__docs" href="/docs/">Read the docs</a>
      </div>
    </section>
  </main>
</SiteLayout>
