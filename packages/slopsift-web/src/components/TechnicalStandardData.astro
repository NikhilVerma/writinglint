---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="standard-data-control" data-standard-data-control hidden>
  <span data-standard-data-status>Dictionary checks need your local parsed Issue 9 file.</span>
  <label for={id}>Load local standard data</label>
  <input id={id} data-standard-data-input type="file" accept=".json,application/json" hidden />
</div>
