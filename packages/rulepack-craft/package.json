{
  "name": "writinglint-rulepack-craft",
  "version": "0.1.1",
  "description": "Craft rulepack for the WritingLint grammar linter: better-writing rules — hedged openers, verdict words with no evidence, self-undercutting asides, reflexive apologies, metronome sentence rhythm.",
  "type": "module",
  "license": "MIT",
  "author": "Nikhil Verma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikhilVerma/writinglint.git",
    "directory": "packages/rulepack-craft"
  },
  "bugs": {
    "url": "https://github.com/NikhilVerma/writinglint/issues"
  },
  "homepage": "https://github.com/NikhilVerma/writinglint#readme",
  "keywords": [
    "grammar",
    "linter",
    "prose",
    "hedging",
    "weasel-words",
    "confident-writing",
    "writing-style",
    "rulepack",
    "writinglint"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "writinglint-core": "^0.1.1"
  },
  "devDependencies": {
    "writinglint-parser-node": "^0.1.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
