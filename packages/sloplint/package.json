{
  "name": "sloplint",
  "version": "0.1.0",
  "description": "Lint Markdown, prose, and source-code comments for AI writing slop.",
  "type": "module",
  "license": "MIT",
  "author": "Nikhil Verma",
  "bin": {
    "sloplint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "MODEL.md",
    "RELEASING.md",
    "CALIBRATION.md",
    "AUDIT.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-slop",
    "linter",
    "markdown",
    "comments",
    "cli"
  ],
  "dependencies": {
    "ignore": "^7.0.5",
    "tinyglobby": "^0.2.17",
    "writinglint-core": "^0.1.0",
    "writinglint-parser-node": "^0.1.0",
    "writinglint-rulepack-ai-style": "^0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
