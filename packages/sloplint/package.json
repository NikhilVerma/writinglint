{
  "name": "sloplint",
  "version": "0.1.0",
  "description": "Lint Markdown, prose, and source-code comments for AI writing slop.",
  "type": "module",
  "license": "MIT",
  "author": "Nikhil Verma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikhilVerma/writinglint.git",
    "directory": "packages/sloplint"
  },
  "bugs": {
    "url": "https://github.com/NikhilVerma/writinglint/issues"
  },
  "homepage": "https://github.com/NikhilVerma/writinglint/tree/main/packages/sloplint#readme",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "sloplint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "MODEL.md",
    "RELEASING.md",
    "CALIBRATION.md",
    "AUDIT.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-slop",
    "linter",
    "markdown",
    "comments",
    "cli",
    "prose",
    "ai-writing",
    "writinglint"
  ],
  "dependencies": {
    "ignore": "^7.0.5",
    "tinyglobby": "^0.2.17",
    "writinglint-core": "^0.1.0",
    "writinglint-parser-node": "^0.1.0",
    "writinglint-rulepack-ai-style": "^0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
