{
  "name": "sloplint-web",
  "version": "0.1.0",
  "description": "The Sloplint product site and private, on-device browser demo.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run copy-runtime && npm run build:client && astro dev",
    "check-types": "tsc --noEmit -p tsconfig.client.json",
    "build:client": "node build-client.mjs",
    "copy-runtime": "node copy-runtime.mjs",
    "build": "npm run copy-runtime && npm run build:client && astro build",
    "build:site": "npm run build:client && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "^7.1.1",
    "onnxruntime-web": "^1.27.0",
    "writinglint-core": "*",
    "writinglint-parser-node": "*",
    "writinglint-rulepack-ai-style": "*"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
